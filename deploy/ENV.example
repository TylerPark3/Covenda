# Covenda — environment variables, in the order you can actually fill them in.
#
# Derived from what the CODE reads, not from what Vercel happens to have. Vercel's project
# carries 26; the code reads far fewer. Five of the seven POSTGRES_* variables are read by
# nothing at all — the Vercel/Supabase integration added them automatically.
#
# Values are blank because they cannot be copied out of Vercel: they are stored encrypted,
# which is write-only. Get each from the source named above it.


# ══ TIER 1 — WITHOUT THESE THREE, NOBODY CAN SIGN IN ═════════════════════════════════
# Supabase dashboard → your project → Settings → API
#
# There is ONE page with everything in this block.

# "Project URL" at the top of the API settings page. Looks like https://xxxx.supabase.co
SUPABASE_URL=

# The PUBLIC key — safe in a browser. On the same page under "Project API keys".
# Newer Supabase calls it "publishable" (sb_publishable_...); older calls it "anon public"
# (a long eyJ... token). Either works — the code tries publishable first, then anon.
SUPABASE_PUBLISHABLE_KEY=

# The SECRET key — server only, NEVER in a browser. Same page, marked "service_role" or
# "secret". Supabase hides it behind a Reveal button. This one bypasses every row-level
# security policy you have, so treat it like a database password.
SUPABASE_SECRET_KEY=


# ══ TIER 2 — THE SITE RUNS, BUT THESE FEATURES DO NOT ════════════════════════════════

# Admin console access. Your own value: comma-separated emails. Not issued by anyone.
COVENDA_ADMIN_EMAILS=

# Email. resend.com → API Keys.
# NOTE: the key currently in production (re_VZNK...) was flagged for revocation and is
# still live. Creating a fresh one here is faster than finding the old one, and retires it.
RESEND_API_KEY=
COVENDA_NOTIFICATION_FROM=

# Model calls — résumé questions, brief scoping. console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Payments. dashboard.stripe.com → Developers → API keys.
STRIPE_SECRET_KEY=
# ⚠ The webhook secret is PER ENDPOINT. Do not copy the Vercel one to a new host: signature
# verification fails silently — checkout still appears to work and no webhook ever lands.
# Create a new endpoint pointing at the new host, then paste ITS signing secret here.
STRIPE_WEBHOOK_SECRET=


# ══ TIER 3 — OPTIONAL, AND ONE IS ALREADY OBSOLETE ═══════════════════════════════════

# Read by api/submissions.js only, as a fallback write path.
# Supabase → Settings → Database → Connection string (the pooled one, port 6543).
POSTGRES_URL=

# Authenticates the scheduled jobs. Your own value — any long random string.
CRON_SECRET=

# LEGACY. api/storage.js reads and writes Supabase Storage now; the last @vercel/blob import
# is gone. This exists only so old absolute blob.vercel-storage.com URLs still resolve.
# Once no stored record points at one, delete this variable entirely.
BLOB_READ_WRITE_TOKEN=


# ══ NOT NEEDED ON THE SERVER ═════════════════════════════════════════════════════════
# POSTGRES_URL_NON_POOLING is read ONLY by scripts/migrate.mjs, which you run on your
# laptop. It does not belong in Render or Vercel. Put it in your local .env.local if you
# want `npm run migrate` to work: Supabase → Settings → Database → Direct connection (5432).
#
# POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DATABASE, POSTGRES_PRISMA_URL,
# SUPABASE_JWT_SECRET, BLOB_STORE_ID, BLOB_WEBHOOK_PUBLIC_KEY and the four NEXT_PUBLIC_*
# duplicates are read by NOTHING in this codebase. Vercel's integration added them. You do
# not need to carry them to a new host.
